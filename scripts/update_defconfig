#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (C) 2022 Utsav Balar

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/update_defconfig [OPTIONS] [DEVICE ...]
Generate Xiaomi defconfigs from the Qualcomm and Xiaomi base fragments.
With no devices, generate all twelve device configs.

  --check                 Compare generated configs without changing sources
  --android-root DIR      Override the automatically discovered Android root
  --clang-dir DIR         Use this toolchain directory (or its bin directory)
  --clang-version REV     Select an Android Clang revision, or "latest"
  -j, --jobs N            Limit parallel make jobs (default: nproc)
  -h, --help              Show this help

Default Clang: TARGET_KERNEL_CLANG_VERSION from BoardConfigCommon.mk,
then the Android Soong default, then the newest installed Android revision.
Standalone kernels can use --clang-dir or the Clang/LLVM tools on PATH.
Requirements and examples: scripts/update_defconfig.md
EOF
}
fail() { printf 'update_defconfig: %s\n' "$*" >&2; exit 1; }
need_value() { [[ $# -ge 2 && -n $2 ]] || fail "$1 requires a value"; }

kernel_top=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
config_dir=$kernel_top/arch/arm64/configs/vendor/xiaomi
android_root=
clang_dir=
clang_version=
jobs=
check=false
devices=()
all_devices=(alioth apollo cas cmi dagu elish enuma lmi munch umi thyme psyche)
while (($#)); do
    case $1 in
        --check) check=true; shift ;;
        --android-root) need_value "$@"; android_root=$2; shift 2 ;;
        --clang-dir) need_value "$@"; clang_dir=$2; shift 2 ;;
        --clang-version) need_value "$@"; clang_version=$2; shift 2 ;;
        -j|--jobs) need_value "$@"; jobs=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; devices+=("$@"); break ;;
        -*) fail "unknown option: $1" ;;
        *) devices+=("$1"); shift ;;
    esac
done
((${#devices[@]})) || devices=("${all_devices[@]}")
for device in "${devices[@]}"; do
    case " ${all_devices[*]} " in
        *" $device "*) ;;
        *) fail "unsupported device: $device" ;;
    esac
done
[[ -z $clang_dir || -z $clang_version ]] || fail "choose --clang-dir or --clang-version"
[[ -z $jobs || $jobs =~ ^[1-9][0-9]*$ ]] || fail "jobs must be a positive integer"
for tool in make flex bison sed grep sort mktemp cp cmp diff head tail dirname mkdir rm bash nproc; do
    command -v "$tool" >/dev/null || fail "missing host tool: $tool (see scripts/update_defconfig.md)"
done
jobs=${jobs:-$(nproc)}

if [[ -z $android_root ]]; then
    candidate=$kernel_top
    while [[ $candidate != / ]]; do
        if [[ -f $candidate/build/envsetup.sh && -d $candidate/prebuilts/clang/host/linux-x86 ]]; then
            android_root=$candidate
            break
        fi
        candidate=$(dirname -- "$candidate")
    done
    if [[ -z $android_root && -n ${ANDROID_BUILD_TOP:-} ]]; then
        android_root=$ANDROID_BUILD_TOP
    fi
fi
if [[ -n $android_root ]]; then
    [[ -d $android_root/prebuilts/clang/host/linux-x86 ]] || fail "Android root has no Clang prebuilts: $android_root"
    android_root=$(cd -- "$android_root" && pwd -P)
fi
if [[ -z $clang_dir ]]; then
    if [[ -n $android_root ]]; then
        clang_root=$android_root/prebuilts/clang/host/linux-x86
        if [[ -z $clang_version ]]; then
            board=$android_root/device/xiaomi/sm8250-common/BoardConfigCommon.mk
            if [[ -f $board ]]; then
                clang_version=$(sed -nE 's/^[[:space:]]*TARGET_KERNEL_CLANG_VERSION[[:space:]]*:?=[[:space:]]*(r[0-9]+[a-z]*).*/\1/p' "$board" | head -n 1)
            fi
            if [[ -z $clang_version && -f $android_root/build/soong/cc/config/global.go ]]; then
                clang_version=$(sed -nE 's/^[[:space:]]*ClangDefaultVersion[[:space:]]*=[[:space:]]*"(clang-r[0-9]+[a-z]*)".*/\1/p' "$android_root/build/soong/cc/config/global.go" | head -n 1)
            fi
            clang_version=${clang_version:-latest}
        fi
        if [[ $clang_version == latest ]]; then
            shopt -s nullglob
            candidates=()
            for candidate in "$clang_root"/clang-r*/bin/clang; do
                [[ -x $candidate ]] && candidates+=("$(dirname -- "$(dirname -- "$candidate")")")
            done
            ((${#candidates[@]})) || fail "no installed Android Clang revisions in $clang_root"
            clang_dir=$(printf '%s\n' "${candidates[@]}" | sort -V | tail -n 1)
        else
            [[ $clang_version =~ ^(clang-)?r[0-9]+[a-z]*$ ]] || fail "invalid Clang revision: $clang_version"
            clang_dir=$clang_root/clang-${clang_version#clang-}
        fi
    else
        [[ -z $clang_version ]] || fail "--clang-version needs an Android root; use --clang-dir for a standalone kernel"
        clang_path=$(command -v clang) || fail "no Android root or Clang on PATH; use --clang-dir"
        clang_dir=$(dirname -- "$clang_path")
    fi
fi
[[ -d $clang_dir/bin ]] && clang_dir=$clang_dir/bin
[[ -d $clang_dir ]] || fail "Clang directory does not exist: $clang_dir"
clang_dir=$(cd -- "$clang_dir" && pwd -P)
for tool in clang clang++ ld.lld llvm-ar llvm-nm llvm-objcopy llvm-objdump llvm-strip llvm-readelf; do
    [[ -x $clang_dir/$tool ]] || fail "toolchain is missing $tool: $clang_dir"
done
export PATH="$clang_dir:$PATH"
clang --version >/dev/null || fail "Clang cannot run on this host"

# Use identical LLVM arguments for Kconfig resolution and savedefconfig.
# This tree supports LLVM=1; llvm-as assembles LLVM IR, not kernel assembly.
make_args=(ARCH=arm64 LLVM=1 LLVM_IAS=1 CC=clang LD=ld.lld AS=clang
           AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump
           STRIP=llvm-strip READELF=llvm-readelf HOSTCC=clang HOSTCXX=clang++
           CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-
           CLANG_TRIPLE=aarch64-linux-gnu-)
unset KCONFIG_CONFIG KCONFIG_ALLCONFIG KCONFIG_AUTOCONFIG KCONFIG_AUTOHEADER
unset KCONFIG_TRISTATE KBUILD_OUTPUT KBUILD_SRC
base=$config_dir/../kona-perf_defconfig
common=$config_dir/sm8250-common.config
for fragment in "$base" "$common"; do
    [[ -r $fragment ]] || fail "missing fragment: $fragment"
done
for device in "${devices[@]}"; do
    [[ -r $config_dir/$device.config ]] || fail "missing fragment: $config_dir/$device.config"
done

# Only remove our unique temporary directory; never reuse or delete kernel/temp.
work=$(mktemp -d "${TMPDIR:-/tmp}/xiaomi-defconfig.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
printf 'Kernel: %s\nAndroid: %s\nClang: %s\n' "$kernel_top" "${android_root:-standalone}" "$clang_dir"
clang --version | head -n 1
mkdir -p "$work/generated"
for device in "${devices[@]}"; do
    printf '\nGenerating %s_defconfig\n' "$device"
    build=$work/$device
    mkdir -p "$build"
    cp -- "$base" "$build/base.config"
    cp -- "$common" "$build/common.config"
    cp -- "$config_dir/$device.config" "$build/device.config"
    # The old merge helper splits paths internally, so pass relative filenames.
    (cd -- "$build"; bash "$kernel_top/scripts/kconfig/merge_config.sh" -m base.config common.config device.config)
    make -C "$kernel_top" O="$build" -j"$jobs" "${make_args[@]}" KCONFIG_ALLCONFIG="$build/.config" alldefconfig
    make -C "$kernel_top" O="$build" -j"$jobs" "${make_args[@]}" savedefconfig
    [[ -s $build/defconfig ]] || fail "empty generated config for $device"
    cp -- "$build/defconfig" "$work/generated/${device}_defconfig"
done
# Wait until every device succeeds before updating any tracked source files.
result=0
for device in "${devices[@]}"; do
    generated=$work/generated/${device}_defconfig
    destination=$kernel_top/arch/arm64/configs/${device}_defconfig
    if "$check"; then
        if ! cmp -s -- "$destination" "$generated"; then
            diff -u -- "$destination" "$generated" || true
            result=1
        fi
    elif ! cmp -s -- "$destination" "$generated"; then
        cp -- "$generated" "$destination"
    fi
done
if "$check"; then
    ((result == 0)) || fail "generated defconfigs differ; run without --check to update"
    printf '\nAll selected defconfigs match generated output.\n'
else
    printf '\nGenerated: %s\nEdit base fragments, never generated device defconfigs.\n' "${devices[*]}"
fi
